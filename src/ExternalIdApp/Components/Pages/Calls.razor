@page "/calls"
@using AppContracts
@using ExternalIdApp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Identity.Web
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler

@rendermode InteractiveServer

@attribute [Authorize]

@inject ClientService ClientService
@inject ClientPublicService ClientPublicService

@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Counter</PageTitle>

<h1>Calls</h1>
<hr/>
<h2>Client Claims</h2>



<p>Hello - @_user</p>
<ul>
    @foreach (var claim in _claims)
    {
        <li>@claim.Item1 : @claim.Item2</li>
    }
</ul>
<hr/>
<div class="row">
    <div class="col-4">
        <div>
            <button class="btn btn-primary" @onclick="CallPingUserContext">Call /ping with user context</button>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" @onclick="CallPingAppContext">Call /ping with app context</button>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" @onclick="CallPingAdminUserContext">Call /ping/admin with user context
            </button>

        </div>
        <div class="mt-4">
            <button class="btn btn-primary" @onclick="CallPingAdminAppContext">Call /ping/admin with app context
            </button>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" @onclick="CallPingPublicUserContext">Call /ping/public with user context
            </button>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" @onclick="CallPingPublicAppContext">Cal /ping/public with app context
            </button>
        </div>
    </div>
    <div class="col-8">
        <h3>@_title</h3>
        @if (_ping != null)
        {
            <p>EP Description: @_ping.Description</p>
            <ul>
                @foreach (var claim in _ping.Claims)
                {
                    <li>@claim.Type : @claim.Value</li>
                }
            </ul>
        }
    </div>
</div>

@if (_error != null)
{
    <p>@_error.Message</p>
    <p>@_error.StackTrace</p>
}

@code {
    private Exception? _error;
    private HttpResponseMessage? _response;
    private List<(string, string)> _claims = [];
    private string _user = string.Empty;
    private string _title = string.Empty;
    private PingResponse? _ping;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = state.User.Identity?.Name ?? "Unknown";
        _claims = state.User.Claims.Select(c => (c.Type, c.Value)).ToList();
    }

    private Task CallPingUserContext() => Call(ClientService, "/ping");


    private Task CallPingAppContext() => Call(ClientPublicService, "/ping");


    private Task CallPingAdminUserContext() => Call(ClientService, "/ping/admin");


    private Task CallPingAdminAppContext() => Call(ClientPublicService, "/ping/admin");


    private Task CallPingPublicUserContext() => Call(ClientService, "/ping/public");
 

    private Task CallPingPublicAppContext()=> Call(ClientPublicService, "/ping/public");
  

    private async Task<HttpResponseMessage?> Call(ClientService client, string address)
    {
        _error = null;
        _response = null;
        _ping = null;
        try
        {
            _response = await client.Call(address);
            var context = client == ClientService ? "User" : "App";
            _title = $"Call /ping with {context} context - Address {address} - Status {_response.StatusCode}";
            if (_response.IsSuccessStatusCode)
            {
                _ping = await _response.Content.ReadFromJsonAsync<PingResponse>();
            }
        }
        catch (MicrosoftIdentityWebChallengeUserException ex)
        {
            ConsentHandler.HandleException(ex);
        }
        catch (Exception ex)
        {
            _error = ex;
        }
        finally
        {
            StateHasChanged();
        }

        return null;
    }

}